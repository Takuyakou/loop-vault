#!/bin/sh
# Blocks private audio and generated output from entering a commit.
# Install with: npm run hooks:install
node scripts/check-staged-files.mjs || exit 1

# Validate the Phase 11 documents whenever they are staged.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^docs/phase11\.0/'; then
  npm run validate:phase-docs || exit 1
fi
