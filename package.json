{
  "name": "loop-vault",
  "private": true,
  "license": "UNLICENSED",
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . && npm run lint:classes && npm run lint:source-contracts",
    "lint:classes": "node scripts/lint-tailwind-classes.mjs",
    "lint:source-contracts": "node scripts/lint-source-contracts.mjs",
    "check:staged": "node scripts/check-staged-files.mjs",
    "validate:phase-docs": "node scripts/phase-docs/validate.mjs",
    "validate:ai-handoff": "node scripts/ai-handoff/validate.mjs",
    "validate:docs-layout": "node scripts/docs-layout/validate.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "node scripts/test-dx/run.mjs fast",
    "test:feature": "node scripts/test-dx/run.mjs feature",
    "test:ui": "node scripts/test-dx/run.mjs ui",
    "test:full": "node scripts/test-dx/run.mjs full",
    "test:full:all": "node scripts/test-dx/run.mjs full-all",
    "test:e2e:extended": "node scripts/test-dx/run.mjs extended",
    "p89:screens": "node scripts/p89/screens.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright-visual-tests.mjs",
    "test:e2e:update-baselines": "node scripts/run-playwright-visual-tests.mjs --update-snapshots",
    "test:e2e:update": "npm run test:e2e:update-baselines",
    "test:e2e:settings-visual": "node scripts/run-playwright-visual-tests.mjs e2e/visual.spec.ts --grep \"Settings visual baseline\"",
    "test:e2e:settings-visual:update-baseline": "node scripts/run-playwright-visual-tests.mjs e2e/visual.spec.ts --grep \"Settings visual baseline\" --update-snapshots",
    "test:e2e:capture-results-visual": "node scripts/run-playwright-visual-tests.mjs e2e/visual.spec.ts --grep \"Capture states and correction workflow\"",
    "test:e2e:capture-results-visual:update-baseline": "node scripts/run-playwright-visual-tests.mjs e2e/visual.spec.ts --grep \"Capture states and correction workflow\" --update-snapshots=changed",
    "test:playwright-visual-runner": "node --test scripts/run-playwright-visual-tests.node-test.mjs",
    "test:e2e:report": "playwright show-report",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "playwright:install": "playwright install chromium",
    "seed:demo": "node scripts/seed-demo.mjs",
    "tune:midi-reranker": "vite-node scripts/tune-legacy-boundary-reranker.ts",
    "diagnose:p441:validation": "vite-node scripts/trace-phase441-validation.ts",
    "generate:p47:corpus": "vite-node scripts/phase47/generateBassCompanionCorpus.ts",
    "tune:midi-weights": "vite-node scripts/tune-midi-weights.ts",
    "benchmark:midi": "vite-node scripts/benchmark-midi-analysis.ts",
    "benchmark:live-midi": "vite-node scripts/benchmark-live-midi-latency.ts",
    "benchmark:dojo": "vite-node scripts/benchmark-chord-dojo.ts",
    "benchmark:p518": "node --expose-gc node_modules/vite-node/vite-node.mjs scripts/p518-resource-benchmark.ts",
    "benchmark:p5181": "node --expose-gc node_modules/vite-node/vite-node.mjs scripts/p5181-source-switch-benchmark.ts",
    "benchmark:p519": "node --expose-gc node_modules/vite-node/vite-node.mjs scripts/p519-root-motion-benchmark.ts",
    "benchmark:p522": "vite-node scripts/p522-source-bassline-benchmark.ts",
    "diagnose:midi-failures": "vite-node scripts/analyze-midi-failures.ts",
    "ablate:midi": "vite-node scripts/ablate-midi-analysis.ts",
    "tauri": "tauri",
    "audio:ab:freepats": "node scripts/render-freepats-bass-ab.mjs",
    "security:scan": "node scripts/security/trackedSecurityScan.mjs",
    "test:security-scripts": "node --test scripts/security/*.node-test.mjs",
    "security:audit": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tonejs/midi": "^2.0.28",
    "lucide-react": "^1.24.0",
    "midi-file": "^1.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.1.22",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.6.0",
    "ffmpeg-static": "5.2.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
