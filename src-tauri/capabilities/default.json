{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main Loop Vault window",
  "windows": ["main", "live-midi"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-position",
    "core:window:allow-set-resizable",
    "core:window:allow-set-min-size",
    "core:window:allow-set-size",
    "core:window:allow-set-size-constraints",
    "dialog:default",
    "opener:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/loopvault" },
        { "path": "$APPDATA/loopvault/**" },
        { "path": "$APPDATA/com.takuyakou.loopvault" },
        { "path": "$APPDATA/com.takuyakou.loopvault/**" },
        { "path": "$LOCALDATA/loopvault" },
        { "path": "$LOCALDATA/loopvault/**" },
        { "path": "$LOCALDATA/com.takuyakou.loopvault" },
        { "path": "$LOCALDATA/com.takuyakou.loopvault/**" },
        { "path": "$AUDIO/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    }
  ]
}
